# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Which environment to target: local | dev | staging | prod (default: dev)
ENV=dev

# Optional one-off override, wins over the environment's baseURL.
# Useful for review apps and preview deployments.
# BASE_URL=https://preview-1234.example.com

# Credentials per role, read by credentialsFor() in config/environments.ts.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# STANDARD_USERNAME=
# STANDARD_PASSWORD=
